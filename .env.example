# ─────────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────
SERVER_PORT=8080

# development (default) | production. Selects the default origin allowlist;
# any other value is treated as production.
GEODISPATCH_ENV=development

# Comma-separated exact origins (scheme://host[:port]) allowed to open /ws
# and to call /sensor, /health and /capabilities from a browser. Empty uses
# the defaults: localhost/127.0.0.1 on ports 5173, 4173 and 3000 in
# development, none in production. "*" is honoured only in development.
ALLOWED_ORIGINS=

# ─────────────────────────────────────────────────────────────
# MOCK SERVER PORTS (Local Testing)
# ─────────────────────────────────────────────────────────────
MOCK_CAMARA_PORT=8081
# Not 5000: macOS reserves it for the AirPlay Receiver.
MOCK_AGENT_PORT=8082

# ─────────────────────────────────────────────────────────────
# NOKIA NETWORK AS CODE — CAMARA
# ─────────────────────────────────────────────────────────────
NOKIA_NAC_BASE_URL=https://network-as-code.nokia.rapidapi.com
# Development tool (service mock_camara in docker-compose.standalone.yml, or
# the deploy repository): synthetic fixtures, used while NOKIA_NAC_API_KEY is
# empty.
MOCK_NOKIA_NAC_BASE_URL=http://mock_camara:8081

NOKIA_NAC_HOST=network-as-code.nokia.rapidapi.com

# leave empty for mock
NOKIA_NAC_API_KEY=

# How old (seconds) a cached device location may be (600 = 10 min)
CAMARA_LOCATION_MAX_AGE_SEC=600

# Per CAMARA HTTP call, and the (shorter) reachability lookup. A failed
# reachability lookup means NOT_CONNECTED is assumed and reported as such.
CAMARA_TIMEOUT_MS=5000
CAMARA_REACHABILITY_TIMEOUT_MS=1000

# ─────────────────────────────────────────────────────────────
# AI AGENT
# ─────────────────────────────────────────────────────────────
# mock_agent is the rule-based development tool in
# docker-compose.standalone.yml (earthquake only). Point this at the Python
# agent's /decide (port 8000) to use it.
# The readiness check probes the sibling /health.
AGENT_URL=http://mock_agent:8082/decide

# Per-batch agent HTTP timeout, and devices per request (clamped to 1..20).
AGENT_TIMEOUT_SEC=120
AGENT_BATCH_SIZE=20

# ─────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgres://geodispatch:geodispatch@postgres:5432/geodispatch?sslmode=disable"

# ─────────────────────────────────────────────────────────────
# SMS GATEWAY
# ─────────────────────────────────────────────────────────────
# No SMS gateway is implemented. Leave empty (the only supported value):
# SMS is reported as not_configured and nothing is ever reported as sent.
SMS_GATEWAY=

# ─────────────────────────────────────────────────────────────
# LOCAL SERVICES
# ─────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434

# ─────────────────────────────────────────────────────────────
# PIPELINE, SENSOR AND WEBSOCKET LIMITS
# ─────────────────────────────────────────────────────────────
# Triage fan-out (concurrent CAMARA lookups).
CAMARA_CONCURRENCY=50
# Whole-pipeline deadline; exceeding it fails the event.
PIPELINE_TIMEOUT_SEC=900
# POST /sensor body limit.
SENSOR_MAX_BODY_BYTES=16384
# Frames queued per dashboard client before it is disconnected as too slow
# (it reconnects and gets a fresh snapshot), per-frame write deadline and
# heartbeat period.
WS_CLIENT_QUEUE_LIMIT=65536
WS_WRITE_TIMEOUT_SEC=10
WS_HEARTBEAT_SEC=15
