
# ─────────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ─────────────────────────────────────────────────────────────
# MOCK SERVER PORTS (Local Testing)
# ─────────────────────────────────────────────────────────────
MOCK_CAMARA_PORT=8081
MOCK_AGENT_PORT=5000

# ─────────────────────────────────────────────────────────────
# EXTERNAL SERVICE URLS (Pointing to Mocks for now)
# ─────────────────────────────────────────────────────────────
# Points to our local Mock CAMARA server (http://localhost:8081)
NOKIA_NAC_BASE_URL=http://localhost:8081
NOKIA_NAC_TOKEN=mock_token_for_testing

# Points to our local Mock AI Agent (http://localhost:5000/decide)
AGENT_URL=http://localhost:5000/decide

# Database — set to "mock" to bypass real PostgreSQL (handled in main.go)
DATABASE_URL=mock

# ─────────────────────────────────────────────────────────────
# SMS GATEWAY (Africa's Talking)
# ─────────────────────────────────────────────────────────────
AFRICASTALKING_API_KEY=your_sandbox_key_here
AFRICASTALKING_USERNAME=sandbox

# ─────────────────────────────────────────────────────────────
# LOCAL SERVICES
# ─────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434

# ─────────────────────────────────────────────────────────────
# CONCURRENCY LIMITS
# ─────────────────────────────────────────────────────────────
CAMARA_CONCURRENCY=50
SMS_CONCURRENCY=100